---
import "@fontsource-variable/montserrat";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const lang = path === "/en" || path.startsWith("/en/") ? "en" : "es";
const description =
  lang === "es"
    ? "Clínica Dental Barceló en El Puerto de Santa María. Servicios completos de odontología: implantes, ortodoncia, estética dental y más. Cuidamos tu sonrisa con profesionalidad y tecnología avanzada."
    : "Barceló Dental Clinic in El Puerto de Santa María. Complete dental services: implants, orthodontics, dental aesthetics and more. We take care of your smile with professionalism and advanced technology.";
const websiteUrl = "https://www.dentalbarcelo.com";
const canonicalUrl = new URL(path, websiteUrl).href.replace(/\/$/, path === "/" ? "/" : "");
const ogImage = `${websiteUrl}/preview.webp`;
// ES <-> EN page pairs for hreflang
const pairs: Record<string, string> = {
  "/": "/en",
  "/politica-privacidad": "/en/privacy-policy",
  "/politica-cookies": "/en/cookie-policy",
  "/terminos-condiciones": "/en/terms-conditions",
};
const esPath = lang === "es" ? path : Object.keys(pairs).find((k) => pairs[k] === path);
const enPath = lang === "en" ? path : pairs[path];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: "Clínica Dental Barceló",
  url: `${websiteUrl}/`,
  image: ogImage,
  telephone: "+34629830040",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle Crucero Baleares, 31",
    addressLocality: "El Puerto de Santa María",
    addressRegion: "Cádiz",
    addressCountry: "ES",
  },
  geo: { "@type": "GeoCoordinates", latitude: 36.5929199, longitude: -6.2382722 },
  hasMap: "https://www.google.com/maps/place/Dental+Barcelo/@36.5929199,-6.2382722,17z",
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <!-- HTML Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="keywords"
      content="Dentista, Ortodoncista, El Puerto de Santa María, Implantes Dentales, Estética Dental"
    />
    <link rel="canonical" href={canonicalUrl} />
    {esPath && <link rel="alternate" hreflang="es" href={new URL(esPath, websiteUrl).href} />}
    {enPath && <link rel="alternate" hreflang="en" href={new URL(enPath, websiteUrl).href} />}
    {esPath && <link rel="alternate" hreflang="x-default" href={new URL(esPath, websiteUrl).href} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_GB"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="dentalbarcelo.com" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script src="/scripts/activeNavLinks.js" defer></script>
  </head>
  <body>
    <div class="mx-auto min-h-screen max-w-6xl md:max-w-full">
      <slot />
    </div>
    <SpeedInsights />
  </body>
</html>
